# Copy into Streamlit Community Cloud: App settings > Secrets. Never commit real values.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key"

# Lets super admins create staff accounts and clean up files when deleting a facility (optional).
# Only used after the app confirms the signed-in person is a super admin. Streamlit keeps secrets on the server.
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"

# AI guidance (optional; the app works without it)
ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-5"

# "Run automated checks now" button on the Verification page (optional)
GITHUB_TOKEN = "github_pat_..."   # fine-grained token with Actions: read and write on this repo
GITHUB_REPO = "your-org/check-and-declare"
GITHUB_BRANCH = "main"

# Sofia Pro through AIA Canada's Adobe Fonts account (optional). Without it the app uses Arial, as the design system allows.
# Add the app's address (for example your-app.streamlit.app) to the web project's domains in Adobe Fonts first.
ADOBE_FONTS_KIT = "abc1def"
